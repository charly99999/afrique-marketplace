# Cloudflare Pages — variables publiques, injectées au build.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<votre-cle-publique>

# Supabase Edge Functions — à définir uniquement côté Supabase, jamais dans Vite.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<secret-server-only>
GOOGLE_GENERATIVE_AI_API_KEY=<secret-server-only>
