{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:cloudflare",
  "outputDirectory": "dist/cloudflare",
  "routes": [
    {
      "src": "/compte",
      "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" },
      "dest": "/index.html"
    },
    {
      "src": "/profil",
      "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" },
      "dest": "/index.html"
    },
    {
      "src": "/suivis",
      "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" },
      "dest": "/index.html"
    },
    {
      "src": "/verification",
      "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" },
      "dest": "/index.html"
    },
    {
      "src": "/vendre",
      "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" },
      "dest": "/index.html"
    },
    {
      "src": "/messages",
      "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" },
      "dest": "/index.html"
    },
    {
      "src": "/administration",
      "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" },
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
